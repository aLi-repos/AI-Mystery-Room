# MysteryAI — environment variables (spec.md §5.5)
# Copy to .env and fill in real values. .env is git-ignored; THIS file is committed.
# NEVER commit real credentials. NEVER prefix secrets with NEXT_PUBLIC_.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host:5432/mysteryai?sslmode=require"

# --- Auth ---
# Signs session JWTs / cookies (required, secret). Generate: openssl rand -base64 32
AUTH_SECRET=""

# --- AI provider (Gemini via provider-independent adapter, decisions D2 + D8) ---
AI_PROVIDER="gemini"
# Server-only Gemini API key (required when AI is enabled; provisioned in phase P4).
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# Default model per decision D8; availability/quotas/pricing re-verified in P4.
AI_MODEL="gemini-3.6-flash"
AI_TIMEOUT_MS="8000"
AI_MAX_RETRIES="1"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Rate limiting (optional overrides, spec.md §9.5) ---
# RATE_LIMIT_ANSWERS_MAX=
# RATE_LIMIT_HINTS_MAX=
# RATE_LIMIT_LOGIN_MAX=

# --- Testing ---
# Set to "true" to enable live AI smoke tests (off by default).
AI_LIVE_TESTS="false"
